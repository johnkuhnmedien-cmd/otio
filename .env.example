# API-Schlüssel nur über Umgebungsvariablen — niemals echte Werte committen.
GEMINI_API_KEY=
# Optional: Standard-Gemini-Modell (siehe otio_app/defaults.py GEMINI_MODEL_CHOICES)
GEMINI_MODEL=gemini-2.0-flash
# Voice-over: whisper (lokal, kostenlos) oder gemini (Cloud)
VOICE_OVER_BACKEND=whisper
# Whisper-Modellgröße: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
