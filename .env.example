# API-Schlüssel — alternativ unter 🔑 API-Schlüssel in der App pflegen.
# Gespeicherte App-Keys landen in data/user_secrets.env (nicht committen).

# --- Aktiv in der App ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Voice-over: whisper (lokal, kostenlos) oder gemini (Cloud)
VOICE_OVER_BACKEND=whisper
WHISPER_MODEL=large-v3

# --- Schnittplan (optional: OpenAI / Claude zum Testen) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
ADOBE_STOCK_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
